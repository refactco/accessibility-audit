{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refact.co/a11y/formats/summary/1",
  "title": "Accessibility Audit summary (summary.json)",
  "description": "The result of each criterion for the site and for each process, the counts, and the coverage of the last audit. See PLAN.md sections 6.3 and 7.2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "site",
    "run",
    "date",
    "standard",
    "level",
    "versions",
    "baseline",
    "counts",
    "coverage",
    "criteria",
    "processes"
  ],
  "$defs": {
    "result": {
      "enum": [
        "failed",
        "needs review",
        "needs a person",
        "no issue found",
        "no content found",
        "not tested",
        "passed",
        "not applicable"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "new",
        "open",
        "resolved",
        "resolved_rule_changed",
        "reopened",
        "not_checked",
        "page_removed",
        "accepted",
        "dismissed"
      ],
      "properties": {
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "open": {
          "type": "integer",
          "minimum": 0
        },
        "resolved": {
          "type": "integer",
          "minimum": 0,
          "description": "Fixes only. Excludes the reason 'rule changed'."
        },
        "resolved_rule_changed": {
          "type": "integer",
          "minimum": 0
        },
        "reopened": {
          "type": "integer",
          "minimum": 0
        },
        "not_checked": {
          "type": "integer",
          "minimum": 0
        },
        "page_removed": {
          "type": "integer",
          "minimum": 0
        },
        "accepted": {
          "type": "integer",
          "minimum": 0
        },
        "dismissed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pages_found",
        "pages_tested",
        "pages_not_tested"
      ],
      "properties": {
        "pages_found": {
          "type": "integer",
          "minimum": 0
        },
        "pages_tested": {
          "type": "integer",
          "minimum": 0
        },
        "pages_not_tested": {
          "type": "integer",
          "minimum": 0
        },
        "pages_in_sample": {
          "type": "integer",
          "minimum": 0
        },
        "states_tested": {
          "type": "integer",
          "minimum": 0
        },
        "forms_tested": {
          "type": "integer",
          "minimum": 0,
          "description": "The forms that got a dry submit. See FORMS.md."
        },
        "processes_tested": {
          "type": "integer",
          "minimum": 0
        },
        "processes_not_tested": {
          "type": "integer",
          "minimum": 0
        },
        "tests_not_run": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "budget_reached": {
          "type": "array",
          "items": {
            "enum": [
              "pages",
              "time",
              "states",
              "questions",
              "issues"
            ]
          }
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "summary/1"
    },
    "site": {
      "type": "string",
      "format": "uri"
    },
    "run": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "standard": {
      "const": "WCAG 2.2"
    },
    "level": {
      "const": "AA"
    },
    "versions": {
      "type": "object",
      "required": [
        "engine",
        "axe_core",
        "browser"
      ],
      "properties": {
        "engine": {
          "type": "string"
        },
        "axe_core": {
          "type": "string"
        },
        "browser": {
          "type": "string"
        },
        "rules_hash": {
          "type": "string",
          "description": "A hash of our own rule set."
        }
      }
    },
    "baseline": {
      "type": "boolean",
      "description": "True when a version changed since the last audit."
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "criteria": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[1-4]\\.[1-5]\\.[0-9]{1,2}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "result",
          "method",
          "coverage"
        ],
        "properties": {
          "result": {
            "$ref": "#/$defs/result"
          },
          "method": {
            "enum": [
              "auto",
              "auto+review",
              "person"
            ]
          },
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tested_units",
              "all_units",
              "definition"
            ],
            "properties": {
              "tested_units": {
                "type": "integer",
                "minimum": 0
              },
              "all_units": {
                "type": "integer",
                "minimum": 0
              },
              "definition": {
                "enum": [
                  "page",
                  "template",
                  "site",
                  "process"
                ],
                "description": "What 'all units' means for this criterion."
              }
            }
          },
          "issues": {
            "type": "integer",
            "minimum": 0
          },
          "accepted": {
            "type": "integer",
            "minimum": 0
          },
          "ai_only_answers": {
            "type": "integer",
            "minimum": 0
          },
          "open_questions": {
            "type": "integer",
            "minimum": 0
          },
          "person_result": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result",
              "by",
              "date",
              "scope"
            ],
            "properties": {
              "result": {
                "enum": [
                  "passed",
                  "not applicable"
                ]
              },
              "by": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "scope": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Pages or templates, with their states."
              },
              "void": {
                "type": "boolean",
                "description": "True when a page in the scope changed or a new page appeared."
              }
            }
          }
        }
      }
    },
    "processes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tested"
        ],
        "properties": {
          "tested": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "description": "Why the audit did not test the process."
          },
          "result": {
            "$ref": "#/$defs/result"
          },
          "criteria": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[1-4]\\.[1-5]\\.[0-9]{1,2}$"
            },
            "additionalProperties": {
              "$ref": "#/$defs/result"
            }
          }
        }
      }
    },
    "groups": {
      "type": "object",
      "description": "The coverage for each group of people of PLAN.md section 3.1.",
      "propertyNames": {
        "enum": [
          "visual",
          "auditory",
          "physical",
          "speech",
          "cognitive",
          "seizure"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "criteria": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          },
          "needs_review": {
            "type": "integer",
            "minimum": 0
          },
          "needs_a_person": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "overview": {
      "type": "object",
      "description": "The accessibility overview: a tool measure, not a conformance claim. WCAG has no score. See PLAN.md section 6.3.",
      "additionalProperties": false,
      "required": [
        "definition",
        "levels",
        "issues",
        "score"
      ],
      "properties": {
        "definition": {
          "type": "string"
        },
        "levels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "A",
            "AA"
          ],
          "properties": {
            "A": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "criteria",
                "units",
                "pages"
              ],
              "properties": {
                "criteria": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "all": {
                      "type": "integer"
                    },
                    "met": {
                      "type": "integer"
                    },
                    "failed": {
                      "type": "integer"
                    },
                    "unknown": {
                      "type": "integer"
                    },
                    "no_content": {
                      "type": "integer"
                    },
                    "not_tested": {
                      "type": "integer"
                    }
                  }
                },
                "units": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "tested": {
                      "type": "number"
                    },
                    "met": {
                      "type": "number"
                    },
                    "no_content": {
                      "type": "number"
                    },
                    "failed": {
                      "type": "number"
                    },
                    "unknown": {
                      "type": "number"
                    },
                    "share_no_failure": {
                      "type": "number"
                    },
                    "share_failed": {
                      "type": "number"
                    },
                    "share_unknown": {
                      "type": "number"
                    }
                  }
                },
                "pages": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "all": {
                      "type": "number"
                    },
                    "no_failure": {
                      "type": "number"
                    },
                    "share": {
                      "type": "number"
                    }
                  }
                }
              }
            },
            "AA": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "criteria",
                "units",
                "pages"
              ],
              "properties": {
                "criteria": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "all": {
                      "type": "integer"
                    },
                    "met": {
                      "type": "integer"
                    },
                    "failed": {
                      "type": "integer"
                    },
                    "unknown": {
                      "type": "integer"
                    },
                    "no_content": {
                      "type": "integer"
                    },
                    "not_tested": {
                      "type": "integer"
                    }
                  }
                },
                "units": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "tested": {
                      "type": "number"
                    },
                    "met": {
                      "type": "number"
                    },
                    "no_content": {
                      "type": "number"
                    },
                    "failed": {
                      "type": "number"
                    },
                    "unknown": {
                      "type": "number"
                    },
                    "share_no_failure": {
                      "type": "number"
                    },
                    "share_failed": {
                      "type": "number"
                    },
                    "share_unknown": {
                      "type": "number"
                    }
                  }
                },
                "pages": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "all": {
                      "type": "number"
                    },
                    "no_failure": {
                      "type": "number"
                    },
                    "share": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        },
        "issues": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "open": {
              "type": "integer"
            },
            "by_severity": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            },
            "by_certainty": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fail": {
                  "type": "integer"
                },
                "ai_fail": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "score": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "definition"
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "definition": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
